NODE_ENV=development
PORT=5000

# Master Database
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=gymsmart
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=postgres

# Tenant Database (Can be same as master in dev)
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_POOL_MAX=5

# Redis
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_key_123456789
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_123456789
DATA_ENCRYPTION_KEY=super_secret_encryption_key_123456789

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

