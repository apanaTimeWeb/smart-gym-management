# Landing backend runtime configuration.
# Never commit real credentials. Replace placeholder secrets in the monolith environment.

PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3001
DEFAULT_RATE_LIMIT_ENABLED=true
NODE_ENV=development

MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=5432
MASTER_DB_NAME=gymsmart_master
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=

DB_POOL_MAX=10
DB_TENANT_POOL_MAX=5
DB_ACQUIRE_TIMEOUT_MS=30000
DB_TENANT_ACQUIRE_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=10000
DB_TENANT_IDLE_TIMEOUT_MS=10000
DB_TOTAL_TENANT_POOL_MAX=40

REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=10000

PUBLIC_TENANT_ID=00000000-0000-4000-8000-000000000001
PUBLIC_TENANT_SLUG=gymsmart-public
PUBLIC_TENANT_NAME=GymSmart Public

HEALTH_DEEP_TOKEN=replace-me
E2E_BOOTSTRAP_TOKEN=replace-me
LANDING_FRONTEND_BASE_URL=http://127.0.0.1:3001
