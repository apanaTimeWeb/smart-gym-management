NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymsmart_master
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-character-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DATABASE_POOL_MAX=20
DATABASE_ACQUIRE_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
TENANT_POOL_BUDGET=10
TENANT_POOL_MAX_PER_DATABASE=1
MASTER_DATABASE_NAME=gymsmart_master
TENANT_DATABASE_PREFIX=tenant_db_
ENCRYPTION_KEY_BASE64=replace-with-a-valid-32-byte-base64-key
SEED_SUPERADMIN_EMAIL=admin@gymsmart.local
SEED_SUPERADMIN_PASSWORD=replace-with-at-least-16-character-password

EXPORT_STORAGE_PATH=/tmp/gymsmart-exports
EXPORT_DOWNLOAD_TTL_HOURS=24
EXPORT_DOWNLOAD_SECRET=replace-with-at-least-32-chars
EXPORT_EMAIL_WEBHOOK_URL=

EXPORT_WHATSAPP_WEBHOOK_URL=https://example.invalid/export-whatsapp

# Invoice resend / backup operations
INVOICE_EMAIL_WEBHOOK_URL=
BACKUP_STORAGE_PATH=/tmp/gymsmart-backups
BACKUP_DOWNLOAD_TTL_HOURS=24
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
