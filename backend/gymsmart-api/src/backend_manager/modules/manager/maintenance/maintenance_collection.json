{
  "info": {
    "name": "Manager Maintenance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "`ManagerMaintenanceApi.fetchMaintenanceIssues`",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": "{{baseUrl}}`/manager/maintenance`"
      }
    },
    {
      "name": "`ManagerMaintenanceApi.createMaintenanceTicket`",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}`/manager/maintenance`"
      }
    },
    {
      "name": "`ManagerMaintenanceApi.resolveMaintenanceTicket`",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}`/manager/maintenance/:id/resolve`"
      }
    }
  ]
}
