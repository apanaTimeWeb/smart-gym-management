{
  "info": {
    "name": "Manager attendance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/draft-07/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET /attendance/history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/attendance/history",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "attendance",
            "history"
          ]
        }
      }
    },
    {
      "name": "GET /attendance/members",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/attendance/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "attendance",
            "members"
          ]
        }
      }
    },
    {
      "name": "GET /attendance/staff",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/attendance/staff",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "attendance",
            "staff"
          ]
        }
      }
    },
    {
      "name": "GET /attendance/stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/attendance/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "attendance",
            "stats"
          ]
        }
      }
    },
    {
      "name": "GET /attendance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/attendance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "attendance"
          ]
        }
      }
    },
    {
      "name": "POST /attendance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/attendance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "attendance"
          ]
        }
      }
    }
  ]
}
