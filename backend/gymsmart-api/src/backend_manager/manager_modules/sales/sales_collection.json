          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sales/membership-report",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sales",
            "membership-report"
          ]
        }
      }
    },
    {
      "name": "GET /sales/overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sales/overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sales",
            "overview"
          ]
        }
      }
    },
    {
      "name": "GET /sales/pending-payments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sales/pending-payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sales",
            "pending-payments"
          ]
        }
