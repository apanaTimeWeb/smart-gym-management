{
  "info": {
    "name": "Manager sales API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/draft-07/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET /sales/all-memberships",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sales/all-memberships",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sales",
            "all-memberships"
          ]
        }
      }
    },
    {
      "name": "GET /sales/membership-report",
      "request": {
        "method": "GET",
