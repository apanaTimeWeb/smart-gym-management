{
  "info": {
    "name": "Manager notifications API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/draft-07/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "PATCH /notifications/read-all",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/read-all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "read-all"
          ]
        }
      }
    },
    {
      "name": "PATCH /notifications/:id/read",
