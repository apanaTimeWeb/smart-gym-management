      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "members"
          ]
        }
      }
    },
