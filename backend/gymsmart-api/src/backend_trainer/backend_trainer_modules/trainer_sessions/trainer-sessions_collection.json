{
  "info": {
    "name": "trainer-sessions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Paginated session list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "sessions"
          ]
        }
      }
    },
    {
      "name": "Session member lookup",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/sessions/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "sessions",
            "members"
          ]
        }
      }
    },
    {
      "name": "Create session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "sessions"
          ]
        }
      }
    },
    {
      "name": "Update session",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/sessions/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "sessions",
            ":id"
          ]
        }
      }
    },
    {
      "name": "Actual frontend cancel contract",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/sessions/:id/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "sessions",
            ":id",
            "cancel"
          ]
        }
      }
    },
    {
      "name": "Documented cancellation compatibility",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/sessions/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "sessions",
            ":id"
          ]
        }
      }
    },
    {
      "name": "Record attendance outcome",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/sessions/:id/attendance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "sessions",
            ":id",
            "attendance"
          ]
        }
      }
    }
  ]
}