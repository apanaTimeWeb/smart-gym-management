{
  "info": {
    "name": "trainer-attendance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Filtered attendance list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/attendance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "attendance"
          ]
        }
      }
    },
    {
      "name": "Attendance KPI counts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/attendance/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "attendance",
            "stats"
          ]
        }
      }
    },
    {
      "name": "Member selector options",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/attendance/members-basic",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "attendance",
            "members-basic"
          ]
        }
      }
    },
    {
      "name": "Create member/staff attendance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/attendance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "attendance"
          ]
        }
      }
    },
    {
      "name": "Close trainer attendance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/attendance/checkout/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "attendance",
            "checkout",
            ":id"
          ]
        }
      }
    },
    {
      "name": "Compatibility checkout",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trainer/attendance/checkout/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "trainer",
            "attendance",
            "checkout",
            ":id"
          ]
        }
      }
    }
  ]
}