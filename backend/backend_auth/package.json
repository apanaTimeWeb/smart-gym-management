{
  "name": "superadmin-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart Gym 360 Superadmin backend foundation built with NestJS, PostgreSQL and TypeORM.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --require @opentelemetry/auto-instrumentations-node/register dist/core-app-main.js",
    "start:dev": "tsx watch src/core-app-main.ts",
    "start:prod": "node --require @opentelemetry/auto-instrumentations-node/register dist/core-app-main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "pytest -q e2e",
    "test:e2e:auth": "pytest -q e2e/superadmin/auth",
    "security:dependency": "npm audit --audit-level=high",
    "security:isolation": "node scripts/check-module-isolation.mjs && node scripts/check-architecture.mjs",
    "security:secrets": "gitleaks detect --no-banner --no-git --redact",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run security:isolation",
    "prepare": "husky",
    "typeorm": "node --import tsx ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- -d ./src/core/database/core-data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- -d ./src/core/database/core-data-source.ts migration:revert",
    "seed": "tsx src/core/database/core-master-seeder.ts",
    "start:dev:otel": "node --require @opentelemetry/auto-instrumentations-node/register --import tsx/esm ./src/core-app-main.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/typeorm": "12.0.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "1.8.1",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "nestjs-pino": "4.4.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@prometheus-io/client": "0.16.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.21",
    "eslint": "9.30.1",
    "eslint-config-prettier": "10.1.5",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "ts-jest": "29.4.0",
    "tsc-alias": "1.8.16",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "@types/pg": "8.23.1",
    "eslint-plugin-import-x": "4.17.1"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
