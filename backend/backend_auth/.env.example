NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://gymsmart:gymsmart@localhost:5432/gymsmart_master
DATABASE_POOL_MAX=20
DATABASE_ACQUIRE_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_LOGIN_MAX=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REFRESH_MAX=20
RATE_LIMIT_AUTH_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ME_MAX=60
RATE_LIMIT_AUTH_ME_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LOGOUT_MAX=20
RATE_LIMIT_AUTH_LOGOUT_WINDOW_SECONDS=60
ALLOW_DETERMINISTIC_SEED_DATA=false
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_TRAINER_PASSWORD=

# OpenTelemetry (Rule 32)
OTEL_SERVICE_NAME=smart-gym-360-superadmin-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
