{
  "info": {
    "name": "Smart Gym 360 - Auth v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:3000/api/v1"},
    {"key": "email", "value": "superadmin@gymsmart.local"},
    {"key": "password", "value": "ChangeMe123!"},
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""}
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{refreshToken}}"}],
        "url": "{{baseUrl}}/auth/refresh"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/auth/logout"
      }
    }
  ]
}
