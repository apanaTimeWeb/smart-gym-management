{
  "info": {
    "name": "Sales - Smart Gym API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sales/all-memberships",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sales",
            "all-memberships"
          ]
        }
      }
    },
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sales/membership-report",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sales",
            "membership-report"
          ]
        }
      }
    },
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sales/overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sales",
            "overview"
          ]
        }
      }
    },
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sales/pending-payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sales",
            "pending-payments"
          ]
        }
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{AUTH_TOKEN}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.add({key: 'x-tenant-id', value: '{{TENANT_ID}}'});"
        ]
      }
    }
  ]
}