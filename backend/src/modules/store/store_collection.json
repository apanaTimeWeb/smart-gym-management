{
  "info": {
    "name": "GymSmart Store Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/store/products?limit=10&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store", "products"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/store/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store", "products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Whey Protein\",\"sku\":\"WP-1KG\",\"price\":59.99,\"stock\":100}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/store/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store", "orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"method\":\"Card\",\"items\":[{\"productId\":1,\"qty\":2}]}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Get Summary",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/store/summary",
          "host": ["{{baseUrl}}"],
          "path": ["api", "store", "summary"]
        }
      }
    }
  ]
}
