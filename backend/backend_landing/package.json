{
  "name": "superadmin-backend-v1",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade NestJS + PostgreSQL + TypeORM backend generated from the supplied Landing frontend contract.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node -r module-alias/register dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "migration:master:run": "tsx ./scripts/run-master-migrations.ts",
    "seed:local": "tsx ./scripts/seed-local-tenant.ts",
    "bootstrap:local": "npm run migration:master:run && npm run seed:local",
    "e2e": "pytest -q e2e",
    "architecture:verify": "tsx ./scripts/verify-architecture.ts",
    "verify": "npm run typecheck && npm run lint && npm run architecture:verify && npm test",
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "module-alias": "^2.2.3",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^17.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/sdk-node": "^0.222.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  }
}
