NODE_ENV=development
PORT=3000
APP_NAME=gym-smart-backend
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=gym_smart_master
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_TOTAL_TENANT_POOL_MAX=40
DB_ACQUIRE_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=10000

PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
PUBLIC_TENANT_SLUG=demo-gym
PUBLIC_TENANT_NAME=GymSmart Demo Gym

HEALTH_DEEP_TOKEN=change-me
TRUST_PROXY=false
LOG_LEVEL=info
DEFAULT_RATE_LIMIT_ENABLED=true
OTEL_SERVICE_NAME=gym-smart-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
