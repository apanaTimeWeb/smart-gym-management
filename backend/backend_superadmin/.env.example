NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymsmart_master
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-this-access-secret-to-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-to-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DATABASE_POOL_MAX=20
DATABASE_ACQUIRE_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
MASTER_DATABASE_NAME=gymsmart_master
TENANT_DATABASE_PREFIX=tenant_db_
ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SEED_SUPERADMIN_EMAIL=admin@gymsmart.local
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
