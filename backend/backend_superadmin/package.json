{
  "name": "superadmin-backend-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Frontend-aligned enterprise Superadmin backend built with NestJS, PostgreSQL and TypeORM.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "pytest -q",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/core/database/master-data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/core/database/run-seed.ts",
    "architecture:check": "node scripts/architecture-gate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^12.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.4.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "eslint-plugin-boundaries": "^5.3.1",
    "jest": "^30.1.3",
    "pino": "^9.10.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "tsx": "^4.20.5",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
