{
  "name": "superadmin-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Admin domain backend for Buildronix Gym Management System \u2014 NestJS + PostgreSQL + TypeORM.",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "pytest -q e2e",
    "db:master:migrate": "typeorm-ts-node-commonjs migration:run -d src/core/database/core-master-data-source.ts",
    "db:tenant:migrate": "typeorm-ts-node-commonjs migration:run -d src/core/database/core-tenant-data-source.ts",
    "db:master:revert": "typeorm-ts-node-commonjs migration:revert -d src/core/database/core-master-data-source.ts",
    "tenant:provision": "ts-node -r tsconfig-paths/register src/core/database/core-tenant-provision.ts",
    "seed:master": "ts-node -r tsconfig-paths/register src/core/database/core-master-seeder.ts",
    "seed:tenant": "ts-node -r tsconfig-paths/register src/core/database/core-tenant-seeder.ts",
    "seed": "npm run seed:master && npm run seed:tenant",
    "security:scan": "gitleaks detect --redact --source .",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25",
    "compression": "^1.8.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "pytest": "^8.4.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.9.2",
    "@types/compression": "^1.8.3",
    "tsc-alias": "^1.8.16",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0"
  },
  "engines": {
    "node": ">=22"
  }
}
