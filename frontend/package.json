    "@tanstack/react-query": "^5.101.2",
    "@types/lodash.debounce": "^4.0.9",
    "apexcharts": "^5.16.0",
    "clsx": "^2.1.1",
    "http-status-codes": "^2.3.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.4",
    "react-apexcharts": "^2.1.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
